{
  "name": "@donmai/nextjs",
  "version": "0.9.0",
  "type": "module",
  "description": "Next.js API route handlers for Donmai. Webhook processor, worker/session management, public stats",
  "author": "Rensei AI (https://rensei.ai)",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RenseiAI/donmai-libraries.git",
    "directory": "packages/nextjs"
  },
  "homepage": "https://github.com/RenseiAI/donmai-libraries/tree/main/packages/nextjs",
  "bugs": {
    "url": "https://github.com/RenseiAI/donmai-libraries/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "nextjs",
    "api-routes",
    "webhook",
    "agent-server",
    "linear"
  ],
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./middleware": {
      "types": "./dist/src/middleware/index.d.ts",
      "import": "./dist/src/middleware/index.js",
      "default": "./dist/src/middleware/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@donmai/core": "workspace:*",
    "@donmai/server": "workspace:*",
    "yaml": "^2.9.0"
  },
  "peerDependencies": {
    "@donmai/plugin-linear": "workspace:*",
    "next": ">=14.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "next": "15.5.18",
    "typescript": "^5.7.3",
    "vitest": "^3.2.3"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build"
  }
}
