{
  "name": "@donmai/cli",
  "version": "0.9.0",
  "type": "module",
  "description": "CLI tools for Donmai. Local orchestrator, remote worker, queue admin",
  "author": "Rensei AI (https://rensei.ai)",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RenseiAI/donmai-libraries.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/RenseiAI/donmai-libraries/tree/main/packages/cli",
  "bugs": {
    "url": "https://github.com/RenseiAI/donmai-libraries/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "cli",
    "orchestrator",
    "worker",
    "agent-management"
  ],
  "bin": {
    "agentfactory": "dist/src/index.js",
    "af-agent": "dist/src/agent.js",
    "af-orchestrator": "dist/src/orchestrator.js",
    "af-worker": "dist/src/worker.js",
    "af-worker-fleet": "dist/src/worker-fleet.js",
    "af-cleanup": "dist/src/cleanup.js",
    "af-add-dep": "dist/src/add-dep.js",
    "af-queue-admin": "dist/src/queue-admin.js",
    "af-analyze-logs": "dist/src/analyze-logs.js",
    "af-linear": "dist/src/linear.js",
    "af-governor": "dist/src/governor.js",
    "af-sync-routes": "dist/src/sync-routes.js",
    "af-setup": "dist/src/setup.js",
    "af-migrate-worktrees": "dist/src/migrate-worktrees.js",
    "af-migrate-config-to-kits": "dist/src/migrate-config-to-kits.js",
    "af-merge-queue": "dist/src/merge-queue.js",
    "af-code": "dist/src/code.js",
    "af-arch": "dist/src/code-arch.js"
  },
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./agent": {
      "types": "./dist/src/lib/agent-runner.d.ts",
      "import": "./dist/src/lib/agent-runner.js",
      "default": "./dist/src/lib/agent-runner.js"
    },
    "./orchestrator": {
      "types": "./dist/src/lib/orchestrator-runner.d.ts",
      "import": "./dist/src/lib/orchestrator-runner.js",
      "default": "./dist/src/lib/orchestrator-runner.js"
    },
    "./cleanup": {
      "types": "./dist/src/lib/cleanup-runner.d.ts",
      "import": "./dist/src/lib/cleanup-runner.js",
      "default": "./dist/src/lib/cleanup-runner.js"
    },
    "./worker": {
      "types": "./dist/src/lib/worker-runner.d.ts",
      "import": "./dist/src/lib/worker-runner.js",
      "default": "./dist/src/lib/worker-runner.js"
    },
    "./worker-fleet": {
      "types": "./dist/src/lib/worker-fleet-runner.d.ts",
      "import": "./dist/src/lib/worker-fleet-runner.js",
      "default": "./dist/src/lib/worker-fleet-runner.js"
    },
    "./queue-admin": {
      "types": "./dist/src/lib/queue-admin-runner.d.ts",
      "import": "./dist/src/lib/queue-admin-runner.js",
      "default": "./dist/src/lib/queue-admin-runner.js"
    },
    "./analyze-logs": {
      "types": "./dist/src/lib/analyze-logs-runner.d.ts",
      "import": "./dist/src/lib/analyze-logs-runner.js",
      "default": "./dist/src/lib/analyze-logs-runner.js"
    },
    "./linear": {
      "types": "./dist/src/lib/linear-runner.d.ts",
      "import": "./dist/src/lib/linear-runner.js",
      "default": "./dist/src/lib/linear-runner.js"
    },
    "./sync-routes": {
      "types": "./dist/src/lib/sync-routes-runner.d.ts",
      "import": "./dist/src/lib/sync-routes-runner.js",
      "default": "./dist/src/lib/sync-routes-runner.js"
    },
    "./setup": {
      "types": "./dist/src/lib/setup-mergiraf-runner.d.ts",
      "import": "./dist/src/lib/setup-mergiraf-runner.js",
      "default": "./dist/src/lib/setup-mergiraf-runner.js"
    },
    "./merge-queue": {
      "types": "./dist/src/lib/merge-queue-runner.d.ts",
      "import": "./dist/src/lib/merge-queue-runner.js",
      "default": "./dist/src/lib/merge-queue-runner.js"
    },
    "./code-intelligence": {
      "types": "./dist/src/lib/code-intelligence-runner.d.ts",
      "import": "./dist/src/lib/code-intelligence-runner.js",
      "default": "./dist/src/lib/code-intelligence-runner.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@donmai/core": "workspace:*",
    "@donmai/plugin-linear": "workspace:*",
    "@donmai/server": "workspace:*",
    "@donmai/architectural-intelligence": "workspace:*",
    "dotenv": "^17.4.2"
  },
  "optionalDependencies": {
    "@donmai/code-intelligence": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.5.4",
    "typescript": "^5.7.3",
    "vitest": "^3.2.3"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build"
  }
}
