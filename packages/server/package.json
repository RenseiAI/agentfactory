{
  "name": "@donmai/server",
  "version": "0.9.6",
  "type": "module",
  "description": "Webhook server and distributed worker pool for Donmai. Redis queues, issue locks, session management",
  "author": "Rensei AI (https://rensei.ai)",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RenseiAI/donmai-libraries.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/RenseiAI/donmai-libraries/tree/main/packages/server",
  "bugs": {
    "url": "https://github.com/RenseiAI/donmai-libraries/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "webhook",
    "worker-pool",
    "redis",
    "agent-server",
    "distributed"
  ],
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "@donmai/core": "workspace:*",
    "@donmai/plugin-linear": "workspace:*",
    "ioredis": "^5.11.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "bench:journal": "tsx bench/journal-bench.ts",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build"
  }
}
