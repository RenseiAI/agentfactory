{
  "name": "@donmai/create-app",
  "version": "0.9.0",
  "type": "module",
  "description": "Create a donmai app — multi-agent fleet management for coding agents",
  "author": "Rensei AI (https://rensei.ai)",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RenseiAI/donmai-libraries.git",
    "directory": "packages/create-app"
  },
  "homepage": "https://github.com/RenseiAI/donmai-libraries/tree/main/packages/create-app",
  "bugs": {
    "url": "https://github.com/RenseiAI/donmai-libraries/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "create",
    "agentfactory",
    "ai-agents",
    "coding-agents",
    "linear",
    "scaffolding"
  ],
  "bin": {
    "create-donmai-app": "dist/src/index.js"
  },
  "main": "./dist/src/index.js",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    },
    "./templates": {
      "types": "./dist/src/templates/index.d.ts",
      "import": "./dist/src/templates/index.js",
      "default": "./dist/src/templates/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^25.9.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.7"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build",
    "test": "vitest run",
    "test:watch": "vitest"
  }
}
