{
  "name": "@donmai/code-intelligence",
  "version": "0.9.0",
  "type": "module",
  "description": "DEPRECATED — Code Intelligence for Donmai (TypeScript). Superseded by the native Go code-intelligence engine in the donmai binary (`donmai code`, `donmai mcp code-intel`); preserved for OSS continuity / downstream pins only.",
  "deprecated": "@donmai/code-intelligence is deprecated and will be removed in a future major. The code-intelligence engine is now native Go inside the donmai binary — use the `donmai code` subcommands or the `donmai mcp code-intel` MCP server (server name af-code-intelligence). This package is preserved for OSS continuity / downstream pins only and receives no further feature work.",
  "author": "Rensei AI (https://rensei.ai)",
  "license": "MIT",
  "engines": {
    "node": ">=22.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RenseiAI/donmai-libraries.git",
    "directory": "packages/code-intelligence"
  },
  "homepage": "https://github.com/RenseiAI/donmai-libraries/tree/main/packages/code-intelligence",
  "bugs": {
    "url": "https://github.com/RenseiAI/donmai-libraries/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "code-intelligence",
    "tree-sitter",
    "bm25",
    "search",
    "agent",
    "ast"
  ],
  "main": "./dist/src/index.js",
  "module": "./dist/src/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "default": "./dist/src/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "dependencies": {
    "xxhash-wasm": "^1.1.0"
  },
  "peerDependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.7",
    "@donmai/architectural-intelligence": "^0.9.0",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@anthropic-ai/claude-agent-sdk": {
      "optional": true
    },
    "@donmai/architectural-intelligence": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@donmai/architectural-intelligence": "workspace:*",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "clean": "rm -rf dist",
    "prepublishOnly": "pnpm clean && pnpm build"
  }
}
